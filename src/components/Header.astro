---
// Testata: marchio "3D Building / by FareLAB" a sinistra, menu a destra.
import { url } from '../lib/url';

const percorso = Astro.url.pathname.replace(/\/?$/, '/');
const home = url('');

const voci = [
  { href: home, etichetta: 'Galleria', sezione: (p: string) => p === home || p.startsWith(url('opere/')) },
  { href: url('chi-siamo/'), etichetta: 'Chi siamo' },
  { href: url('a-cosa-serve/'), etichetta: 'A cosa serve' },
  { href: url('contatti/'), etichetta: 'Contatti' },
].map((v) => ({
  ...v,
  corrente: percorso === v.href,
  inSezione: percorso === v.href || Boolean(v.sezione?.(percorso)),
}));
---

<header class="testata">
  <div class="contenitore testata__riga">
    <a class="marchio" href={home}>
      <span class="marchio__nome">3D Building</span>
      <span class="marchio__firma">by FareLAB</span>
    </a>

    <nav class="menu" aria-label="Menu principale">
      <ul>
        {
          voci.map((v) => (
            <li>
              <a
                href={v.href}
                class:list={['menu__voce', { 'menu__voce--attiva': v.inSezione }]}
                aria-current={v.corrente ? 'page' : undefined}
              >
                {v.etichetta}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .testata {
    border-bottom: var(--filo);
  }

  .testata__riga {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spazio-3) var(--spazio-6);
    padding-block: var(--spazio-5);
  }

  .marchio {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spazio-3);
    padding-block: var(--spazio-2);
    color: var(--inchiostro);
    text-decoration: none;
  }

  .marchio:hover {
    color: var(--inchiostro);
  }

  .marchio__nome {
    font-family: var(--font-titoli);
    font-weight: 600;
    font-size: clamp(1.375rem, 2.4vw, 1.625rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .marchio__firma {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: var(--spaziatura-mono);
    color: var(--petrolio);
    /* "FareLAB" si scrive così: il nome non va messo in maiuscolo. */
    text-transform: none;
  }

  .menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spazio-1) var(--spazio-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__voce {
    display: inline-block;
    padding-block: var(--spazio-3);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--corpo-mono);
    letter-spacing: var(--spaziatura-mono);
    text-transform: uppercase;
    color: var(--testo-secondario);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .menu__voce:hover {
    color: var(--petrolio-scuro);
  }

  .menu__voce--attiva {
    color: var(--petrolio);
    border-bottom-color: var(--petrolio);
  }

  @media (max-width: 40rem) {
    .testata__riga {
      flex-direction: column;
      align-items: flex-start;
      padding-block: var(--spazio-4);
    }

    /* Le quattro voci su una riga sola, distribuite su tutta la larghezza;
       sotto i ~340px tornano a capo (flex-wrap) invece di uscire dallo schermo. */
    .menu {
      width: 100%;
    }

    .menu ul {
      justify-content: space-between;
      gap: 0 var(--spazio-3);
    }

    .menu__voce {
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
    }
  }
</style>

---
// Impaginazione comune a tutte le pagine: <head> con SEO e Open Graph,
// testata, contenuto e piè di pagina.
import '@fontsource-variable/fraunces';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, urlAssoluto } from '../lib/url';
import { NOME_SITO } from '../lib/sito';

interface Props {
  /** Titolo della pagina (senza il nome del sito). Omettilo in home. */
  titolo?: string;
  /** Descrizione per motori di ricerca e anteprime (max ~160 caratteri). */
  descrizione?: string;
  /** URL ASSOLUTO dell'immagine Open Graph. Se manca si usa l'anteprima del sito (public/anteprima-sito.jpg). */
  immagine?: string | null;
  immagineAlt?: string;
  tipo?: 'website' | 'article';
  /** true per pagine da non indicizzare (es. 404). */
  noindex?: boolean;
}

const {
  titolo,
  descrizione = 'Galleria di edifici rilevati con fotogrammetria da drone: modello 3D navigabile, plastico stampato in 3D e realtà aumentata. Monopoli, Valle d\'Itria e Sud-Est barese.',
  immagine,
  immagineAlt,
  tipo = 'website',
  noindex = false,
} = Astro.props;

const titoloCompleto = titolo ? `${titolo} · ${NOME_SITO}` : `${NOME_SITO} — Modelli 3D e plastici di edifici`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Pagine che non sono un'opera: anteprima del sito, 1200×630 (rifatta con npm run anteprima-sito).
const immagineOg = immagine ?? urlAssoluto('anteprima-sito.jpg');
const immagineOgAlt = immagine ? (immagineAlt ?? titolo) : `${NOME_SITO}: galleria di edifici, modelli 3D e plastici`;
const tipoImmagine = /\.png$/i.test(immagineOg) ? 'image/png' : /\.webp$/i.test(immagineOg) ? 'image/webp' : 'image/jpeg';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f3eee4" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph (WhatsApp, Facebook, LinkedIn…) -->
    <meta property="og:site_name" content={NOME_SITO} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titolo ?? NOME_SITO} />
    <meta property="og:description" content={descrizione} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={immagineOg} />
    <meta property="og:image:type" content={tipoImmagine} />
    {
      !immagine && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={immagineOgAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body>
    <a class="salta-al-contenuto" href="#contenuto">Salta al contenuto</a>
    <Header />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>

{
  "name": "3d-building",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3D Building by fareLAB — galleria di modelli 3D di edifici da fotogrammetria da drone e dei loro plastici stampati.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:rete": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "preview:rete": "astro preview --host",
    "ispeziona": "node scripts/ispeziona-dataset.mjs",
    "converti": "node scripts/converti-modello.mjs",
    "poster": "node scripts/poster.mjs",
    "frame": "bash scripts/estrai-frame.sh",
    "segnaposto": "node scripts/genera-segnaposto.mjs",
    "browser:installa": "npx @puppeteer/browsers install chrome-headless-shell@stable --path .cache/browsers",
    "anteprima-sito": "node scripts/anteprima-sito.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@google/model-viewer": "^4.3.1",
    "astro": "^7.3.5",
    "qrcode": "^1.5.4",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@puppeteer/browsers": "^3.2.3",
    "@types/qrcode": "^1.5.6",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.3.0",
    "obj2gltf": "^3.2.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
